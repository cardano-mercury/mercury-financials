# The build context is the parent directory holding every Mercury repo, so this file has to exclude
# the heavy and secret parts of all of them, not just this one.

**/node_modules
**/.git
**/.svelte-kit
**/build
**/dist
**/.vercel
**/.netlify
**/.wrangler
**/.output

# Secrets. Never bake an env file into an image.
**/.env
**/.env.*
!**/.env.example

# The old Laravel app, kept locally for reference. Enormous and irrelevant to the image.
mercury-financials/archive

# Internal working documents (design docs, TRDs, finance docs).
**/.claude

# Editors and OS noise
**/.idea
**/.vscode
**/.DS_Store
**/Thumbs.db

# Other Mercury apps: financials' image needs core, and nothing else.
mercury-invoice
mercury-tokenomics
