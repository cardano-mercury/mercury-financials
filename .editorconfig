# Matches .prettierrc exactly. It has to: an editor or an agent that reads this file but has not
# loaded Prettier will indent one way, Prettier will reformat the other way, and every save fights.
# If you change one of these files, change the other.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Prettier reads this file, so these values must match .prettierrc or they silently override it.
# indent_size maps onto Prettier's tabWidth. This file used to say `indent_style = space` with
# `indent_size = 4` while Prettier said `useTabs: true` and named no tabWidth, so Prettier was
# quietly formatting at tabWidth 4 while core and tokenomics ran at 2.
# Prettier: "useTabs": true, "tabWidth": 2, "printWidth": 100
indent_style = tab
indent_size = 2
max_line_length = 100

# Prettier hard-wraps nothing in markdown, and a trailing double space is a line break in it.
[*.md]
trim_trailing_whitespace = false

# YAML cannot be indented with tabs. The spec forbids it.
[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.json]
indent_style = tab
