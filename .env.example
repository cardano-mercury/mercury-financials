# Drizzle / Postgres
DATABASE_URL="postgres://root:mysecretpassword@localhost:5432/local"

# Redis (BullMQ ingestion queue)
REDIS_URL="redis://localhost:6379"

# Host ports for the compose.yaml containers. Only needed if 5432 / 6379 are already
# taken on your machine. If you change one, match the port in the URL above.
#   PG_PORT=5433      # then DATABASE_URL=...@localhost:5433/local
#   REDIS_PORT=6380   # then REDIS_URL=redis://localhost:6380

# Auth (Better Auth) — shared conventions with mercury-tokenomics
ORIGIN="http://localhost:5173"
BETTER_AUTH_SECRET=""

# Set to your apex domain (e.g. .cardano-mercury.com) to share the session cookie across the
# Mercury apps for SSO. Leave unset for a standalone local instance.
COOKIE_DOMAIN=""

# Single-user "CFO Tool" mode (the default): the first sign-up claims the instance and signups
# close after that. Set to false to run an open, multi-user instance (the hosted public version).
SINGLE_USER_MODE="true"

# Shared demo instance. The app is single-entity: everyone who signs into one instance shares and
# can edit the same wallets and books, there is no per-user isolation. Set this to true on a hosted,
# public showcase instance to show a loud banner on every page saying the data is shared and may be
# reset. Leave false on a private instance run by an actual CFO.
DEMO_MODE="false"

# Blockfrost
BLOCKFROST_NETWORK="mainnet"
BLOCKFROST_PROJECT_ID=""
