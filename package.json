{
	"name": "mercury-financials",
	"private": true,
	"version": "0.1.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"db:start": "docker compose up -d",
		"db:stop": "docker compose down",
		"db:auth": "mercury-core migrate",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:studio": "drizzle-kit studio",
		"change": "node scripts/changes.mjs add",
		"changes:check": "node scripts/changes.mjs check",
		"changes:preview": "node scripts/changes.mjs preview",
		"changes:assemble": "node scripts/changes.mjs assemble",
		"test:coverage": "vitest run --coverage"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^22",
		"@vitest/coverage-v8": "^4.1.10",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.9.0",
		"postgres": "^3.4.9",
		"prettier": "^3.9.5",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.7.2",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.66.0",
		"vite": "^8.2.1",
		"vitest": "^4.1.9"
	},
	"dependencies": {
		"@cardano-mercury/core": "^0.2.1",
		"@lucide/svelte": "^1.31.0",
		"@meshsdk/core": "^1.9.1",
		"better-auth": "~1.6.23",
		"bullmq": "^5.79.4",
		"ioredis": "^5.11.1"
	},
	"description": "Turn a Cardano wallet's on-chain history into a Trial Balance, Balance Sheet, and P&L.",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cardano-mercury/mercury-financials.git"
	},
	"bugs": {
		"url": "https://github.com/cardano-mercury/mercury-financials/issues"
	},
	"homepage": "https://github.com/cardano-mercury/mercury-financials#readme",
	"author": "Cardano Mercury, Inc."
}
